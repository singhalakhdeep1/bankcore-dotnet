{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "DefaultConnection": "Host=localhost;Port=5432;Database=banking_db;Username=postgres;Password=postgres",
        "Redis": "localhost:6379"
    },
    "Cors": {
        "AllowedOrigins": [
            "http://localhost:4200"
        ]
    },
    "Database": {
        "AutoMigrate": true
    },
    "AuthRateLimit": {
        "PermitLimit": 10
    },
    "Interest": {
        "Enabled": true
    },
    "Payments": {
        "SimulatedDeclineRate": 0
    },
    "Jwt": {
        "Secret": "DEV-ONLY-change-me-use-Jwt__Secret-in-real-deployments-0123456789",
        "Issuer": "BankingAPI",
        "Audience": "BankingClient",
        "ExpiryMinutes": 15,
        "RefreshTokenExpiryDays": 7
    },
    "Sharding": {
        "Shards": [
            {
                "Id": "shard_savings",
                "ConnectionString": "Host=localhost;Port=5432;Database=banking_savings;Username=postgres;Password=postgres",
                "ShardType": 0,
                "Weight": 1,
                "IsActive": true
            },
            {
                "Id": "shard_checking",
                "ConnectionString": "Host=localhost;Port=5432;Database=banking_checking;Username=postgres;Password=postgres",
                "ShardType": 1,
                "Weight": 1,
                "IsActive": true
            },
            {
                "Id": "shard_business",
                "ConnectionString": "Host=localhost;Port=5432;Database=banking_business;Username=postgres;Password=postgres",
                "ShardType": 2,
                "Weight": 2,
                "IsActive": true
            }
        ]
    },
    "ReadReplica": {
        "PrimaryConnectionString": "Host=localhost;Port=5432;Database=banking_db;Username=postgres;Password=postgres",
        "Replicas": [
            {
                "Id": "replica_1",
                "ConnectionString": "Host=localhost;Port=5433;Database=banking_db;Username=postgres;Password=postgres",
                "Region": "us-east-1",
                "IsPrimary": false,
                "Weight": 1
            },
            {
                "Id": "replica_2",
                "ConnectionString": "Host=localhost;Port=5434;Database=banking_db;Username=postgres;Password=postgres",
                "Region": "us-west-1",
                "IsPrimary": false,
                "Weight": 1
            }
        ]
    },
    "Cache": {
        "DefaultExpiration": "00:30:00",
        "SlidingExpiration": "00:10:00",
        "KeyPrefix": "bankcore:"
    },
    "ConnectionPool": {
        "MaxPoolSize": 100,
        "MaxWaitAttempts": 10,
        "WaitInterval": "00:00:00.100",
        "ConnectionLifetime": "00:30:00",
        "CommandTimeout": 30,
        "KeepaliveInterval": 60
    },
    "RateLimit": {
        "BucketCapacity": 100,
        "RefillRate": 1.0,
        "KeyPrefix": "ratelimit:"
    },
    "Idempotency": {
        "Expiration": "1.00:00:00",
        "KeyPrefix": "idempotency:"
    },
    "ErrorHandling": {
        "RetryCount": 3,
        "ExceptionsAllowedBeforeBreaking": 5,
        "BreakDuration": "00:01:00",
        "TimeoutDuration": "00:00:30"
    },
    "Stripe": {
        "ApiKey": "sk_test_your_stripe_api_key",
        "WebhookSecret": "whsec_your_webhook_secret"
    },
    "PayPal": {
        "ClientId": "your_paypal_client_id",
        "ClientSecret": "your_paypal_client_secret",
        "Mode": "sandbox"
    },
    "Capacity": {
        "CoresPerServer": 4,
        "MemoryPerServerGB": 16,
        "RedisMemoryPerNodeGB": 8
    },
    "BankingCompliance": {
        "ApplicableRegulations": [
            "PCI DSS",
            "GDPR",
            "SOX",
            "GLBA"
        ],
        "DataRetentionYears": 7,
        "RequireEncryption": true,
        "RequireAuditLogging": true
    }
}
