# Copy to .env (git-ignored) and change the values.
# Generate a JWT secret with:  openssl rand -base64 48
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters

# First administrator, created on startup (password: 10+ chars, upper, lower, digit, symbol).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Change-me-Admin-1!

# Set to Development to enable Swagger UI at http://localhost:5000/swagger
ASPNETCORE_ENVIRONMENT=Production

# Payment gateways. Leave empty to use the simulated gateway (the API says so in its logs and responses).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# Optional database integrations. Leave empty to turn each one off.
# With `docker compose --profile integrations up` use these:
#   MONGODB_URL=mongodb://mongo:27017
#   MYSQL_URL=Server=mysql;Database=bankcore;User=root;Password=change-me-mysql;
#   SQLSERVER_URL=Server=sqlserver;Database=master;User Id=sa;Password=Change-me-1234;TrustServerCertificate=True;
#   RAVENDB_URL=http://ravendb:8080
MONGODB_URL=
MYSQL_URL=
SQLSERVER_URL=
RAVENDB_URL=
MYSQL_ROOT_PASSWORD=change-me-mysql
SQLSERVER_SA_PASSWORD=Change-me-1234
